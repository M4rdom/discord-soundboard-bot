{
  "name": "Discord Soundboard Bot",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "pip install --user -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "anthropic.claude-code"]
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
