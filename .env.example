# Bot token (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_token_here

# ID of the text channel where the panel will live (right-click the channel > Copy ID)
PANEL_CHANNEL_ID=123456789012345678

# Optional: server (guild) ID, to sync the /panel command instantly during development.
# If omitted, the sync is global and can take up to 1 hour to propagate.
GUILD_ID=

# Optional: folder where the sound categories live (defaults to "sounds")
SOUNDS_DIR=sounds

# Optional: how many messages the panel can spread across to fit more than 4
# categories (Discord's per-message Select Menu limit). Defaults to 3, i.e.
# up to 12 categories. Each extra message repeats the Stop Audio button.
PANEL_MAX_MESSAGES=3
